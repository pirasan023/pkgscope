class Pkgscope < Formula
  desc "Inspect and safely uninstall developer tools"
  homepage "https://github.com/pirasan023/pkgscope"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/pirasan023/pkgscope/releases/download/v@VERSION@/pkgscope-v@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@DARWIN_ARM64_SHA256@"
    end

    on_intel do
      url "https://github.com/pirasan023/pkgscope/releases/download/v@VERSION@/pkgscope-v@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@DARWIN_X64_SHA256@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/pirasan023/pkgscope/releases/download/v@VERSION@/pkgscope-v@VERSION@-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@LINUX_ARM64_SHA256@"
    end

    on_intel do
      url "https://github.com/pirasan023/pkgscope/releases/download/v@VERSION@/pkgscope-v@VERSION@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@LINUX_X64_SHA256@"
    end
  end

  def install
    bin.install "pkgscope"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/pkgscope --version")
    assert_match "pkgscope doctor", shell_output("#{bin}/pkgscope doctor")
  end
end
